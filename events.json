{
  "schema": 3,
  "layers": [
    "plugin"
  ],
  "events": {
    "plugin.hwp.open": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "format": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "format"
        ]
      },
      "description": "The surface mounted for the file path; format is hwp or hwpx."
    },
    "plugin.hwp.new": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "description": "A tab without params.path opened a blank document of the editor; name is the file name that its first save proposes."
    },
    "plugin.hwp.place": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "micros",
          "ok"
        ]
      },
      "description": "The answer of core.file.place at the first save of a blank document: path is the chosen file relative to the project root, or null when the person cancelled; error names a refused place."
    },
    "plugin.hwp.close": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ]
      },
      "description": "The surface of the file path was disposed."
    },
    "plugin.hwp.view.content_frame": {
      "layer": "plugin",
      "class": "frame",
      "level": "trace",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "firstResizeAtMs": { "type": "number", "minimum": 0 },
          "resizeAtMs": { "type": "number", "minimum": 0 },
          "resizeCount": { "type": "integer", "minimum": 1 },
          "width": { "type": "number", "minimum": 0 },
          "height": { "type": "number", "minimum": 0 },
          "documentTimeOriginMs": { "type": "number", "minimum": 0 },
          "frameTimeMs": { "type": "number", "minimum": 0 }
        },
        "required": ["sequence", "firstResizeAtMs", "resizeAtMs", "resizeCount", "width", "height", "documentTimeOriginMs", "frameTimeMs"]
      },
      "description": "The HWP view document root dimensions after ResizeObserver and the next animation frame while the diagnostic observer is active."
    },
    "plugin.hwp.phase": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "phase"
        ]
      },
      "description": "The start reached a step: starting, reading, opening or ready."
    },
    "plugin.hwp.read": {
      "layer": "plugin",
      "class": "io",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason",
          "micros",
          "ok"
        ]
      },
      "description": "One read of the file through the files sidecar; reason is start, reload or change, size is the number of bytes read, and error is <code>: <text> when ok is false."
    },
    "plugin.hwp.render": {
      "layer": "plugin",
      "class": "io",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "pages": {
            "type": "number"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "micros",
          "ok"
        ]
      },
      "description": "The editor loaded the bytes of the file and drew its pages; pages is the page count it reported."
    },
    "plugin.hwp.notify": {
      "layer": "plugin",
      "class": "io",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "error"
        ]
      },
      "description": "The notice to the editor that a file was saved failed after the write; the file is saved, and the tab shows the notice failure."
    },
    "plugin.hwp.save": {
      "layer": "plugin",
      "class": "io",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "type": "boolean"
          },
          "size": {
            "type": "number"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "format",
          "overwrite",
          "micros",
          "ok"
        ]
      },
      "description": "One save: the export of the editor and the write through the files sidecar; size is the number of bytes written; format is null when the place of a blank document has no hwp or hwpx extension."
    },
    "plugin.hwp.watch": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "micros",
          "ok"
        ]
      },
      "description": "The request that watches the file on disk."
    },
    "plugin.hwp.watch.failed": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "error"
        ]
      },
      "description": "The files sidecar reported that the watch stopped."
    },
    "plugin.hwp.disk.changed": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "modified": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "modified",
          "action"
        ]
      },
      "description": "The file changed on disk; action is reload when the editor holds no unsaved edits and banner when it does."
    },
    "plugin.hwp.studio.message": {
      "layer": "plugin",
      "class": "input",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "event": {
            "type": "string"
          },
          "modified": {
            "type": "boolean"
          },
          "selection": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "event"
        ]
      },
      "description": "A message of the editor page: listening, save, modified or selection."
    },
    "plugin.hwp.studio.error": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "description": "The editor page reported that it cannot read its state."
    },
    "plugin.hwp.studio.save_failed": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "error"
        ]
      },
      "description": "A save that the editor page started with Command-S failed; the tab shows the same failure."
    },
    "plugin.hwp.request": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "method",
          "micros",
          "ok"
        ]
      },
      "description": "One embed request to the editor page and its answer."
    },
    "plugin.hwp.command": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "name",
          "micros",
          "ok"
        ]
      },
      "description": "One run of a command of the surface: hwp.save, hwp.reload or hwp.request."
    },
    "plugin.hwp.report": {
      "layer": "plugin",
      "class": "call",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "description": "The page of the view failed: an error or a rejection of the page, a refused call of the view channel, or a loss of the view calls; text states the error."
    },
    "plugin.hwp.operation": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "path"
        ]
      },
      "description": "An operation of the surface started: kind is open, save or reload; its identifiers are the cids of the calls and records of the operation."
    }
  }
}
