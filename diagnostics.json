{
  "module": "ui/hwp-diagnostics.js",
  "exposes": {
    "commands": [
      {
        "name": "hwp.diagnostics.frames.start",
        "description": "Starts explicit observation of the HWP view document root after ResizeObserver and the next animation frame.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "sequence": { "type": "integer" },
            "historyEntries": { "type": "integer" },
            "regionHistoryEntries": { "type": "integer" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "sourceClock": { "type": "object", "properties": {
              "documentTimeOriginMs": { "type": "number" },
              "sourceNowMs": { "type": "number" },
              "sourceResolutionMs": { "type": "number", "enum": [1] }
            } },
            "studioViewport": { "type": ["object", "null"], "properties": {
              "markerColor": { "type": "array", "items": { "type": "integer" } },
              "borderWidth": { "type": "number" },
              "rect": { "type": "object", "properties": {
                "left": { "type": "number" }, "top": { "type": "number" },
                "right": { "type": "number" }, "bottom": { "type": "number" }
              } },
              "innerWidth": { "type": "number" }, "innerHeight": { "type": "number" },
              "clientWidth": { "type": "number" }, "clientHeight": { "type": "number" },
              "visualViewport": { "type": "object", "properties": {
                "width": { "type": "number" }, "height": { "type": "number" },
                "offsetLeft": { "type": "number" }, "offsetTop": { "type": "number" },
                "scale": { "type": "number" }
              } },
              "fixedContainingBlock": { "type": "object", "properties": {
                "transform": { "type": "string" }, "perspective": { "type": "string" },
                "filter": { "type": "string" }, "contain": { "type": "string" },
                "willChange": { "type": "string" }, "containerType": { "type": "string" }
              } }
            } }
          }
        }
      },
      {
        "name": "hwp.diagnostics.frames.stop",
        "description": "Stops the active HWP view document-frame observation and cancels its pending animation frame.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "sequence": { "type": "integer" },
            "historyEntries": { "type": "integer" },
            "regionHistoryEntries": { "type": "integer" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "studioViewport": { "type": ["object", "null"], "properties": {
              "markerColor": { "type": "array", "items": { "type": "integer" } },
              "borderWidth": { "type": "number" },
              "rect": { "type": "object", "properties": {
                "left": { "type": "number" }, "top": { "type": "number" },
                "right": { "type": "number" }, "bottom": { "type": "number" }
              } },
              "innerWidth": { "type": "number" }, "innerHeight": { "type": "number" },
              "clientWidth": { "type": "number" }, "clientHeight": { "type": "number" },
              "visualViewport": { "type": "object", "properties": {
                "width": { "type": "number" }, "height": { "type": "number" },
                "offsetLeft": { "type": "number" }, "offsetTop": { "type": "number" },
                "scale": { "type": "number" }
              } },
              "fixedContainingBlock": { "type": "object", "properties": {
                "transform": { "type": "string" }, "perspective": { "type": "string" },
                "filter": { "type": "string" }, "contain": { "type": "string" },
                "willChange": { "type": "string" }, "containerType": { "type": "string" }
              } }
            } }
          }
        }
      },
      {
        "name": "hwp.diagnostics.frames.read",
        "description": "Reads HWP view document-frame state and, while active, a studio resource timing snapshot without starting observation.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "sequence": { "type": "integer" },
            "historyEntries": { "type": "integer" },
            "regionHistoryEntries": { "type": "integer" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "studioClock": { "type": ["object", "null"], "properties": {
              "documentTimeOriginMs": { "type": "number" },
              "snapshotAtMs": { "type": "number" }
            } },
            "resourceTimings": { "type": ["array", "null"], "items": { "type": "object", "properties": {
              "name": { "type": "string" },
              "initiatorType": { "type": "string" },
              "startTime": { "type": "number" },
              "duration": { "type": "number" },
              "fetchStart": { "type": "number" },
              "requestStart": { "type": "number" },
              "responseStart": { "type": "number" },
              "responseEnd": { "type": "number" },
              "transferSize": { "type": "number" },
              "encodedBodySize": { "type": "number" },
              "decodedBodySize": { "type": "number" }
            } } },
            "studioViewport": { "type": ["object", "null"], "properties": {
              "markerColor": { "type": "array", "items": { "type": "integer" } },
              "borderWidth": { "type": "number" },
              "rect": { "type": "object", "properties": {
                "left": { "type": "number" }, "top": { "type": "number" },
                "right": { "type": "number" }, "bottom": { "type": "number" }
              } },
              "innerWidth": { "type": "number" }, "innerHeight": { "type": "number" },
              "clientWidth": { "type": "number" }, "clientHeight": { "type": "number" },
              "visualViewport": { "type": "object", "properties": {
                "width": { "type": "number" }, "height": { "type": "number" },
                "offsetLeft": { "type": "number" }, "offsetTop": { "type": "number" },
                "scale": { "type": "number" }
              } },
              "fixedContainingBlock": { "type": "object", "properties": {
                "transform": { "type": "string" }, "perspective": { "type": "string" },
                "filter": { "type": "string" }, "contain": { "type": "string" },
                "willChange": { "type": "string" }, "containerType": { "type": "string" }
              } }
            } }
          }
        }
      }
    ]
  }
}
