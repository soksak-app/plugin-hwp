  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-app/plugin-hwp.git"
  },
  "engines": {
    "soksak": "^0.0.29"
  },
  "files": [
    "plugin.json",
    "diagnostics.json",
    "ui/hwp-diagnostics.js",
    "events.json",
    "ui/index.html",
    "ui/view.js",
    "ui/view-diagnostics.js",
    "ui/studio-host.js",
