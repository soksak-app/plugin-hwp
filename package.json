{
  "name": "@soksak/plugin-hwp",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "description": "HWP plugin: opens HWP and HWPX documents of the project in rhwp-studio, the editor of rhwp, and saves them through the files sidecar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-app/plugin-hwp.git"
  },
  "engines": {
    "soksak": "^0.0.23"
  },
  "files": [
    "plugin.json",
    "events.json",
    "ui/index.html",
    "ui/view.js",
    "ui/view-diagnostics.js",
    "ui/studio-host.js",
    "ui/hwp.js",
    "ui/events.js",
    "ui/requests.js",
    "ui/studio"
  ],
  "scripts": {
    "build": "node scripts/build-studio.mjs",
    "test": "node scripts/build-test.mjs && node --test test/",
    "check:cases": "node scripts/check-test-cases.mjs"
  },
  "devDependencies": {
    "@rhwp/core": "0.8.7",
    "@soksak/plugin-api": "https://github.com/soksak-app/core/releases/download/v0.0.23/soksak-plugin-api-0.0.23.tgz",
    "jsdom": "^30.1.1"
  }
}
