{
  "id": "hwp",
  "name": "한글 문서",
  "description": "프로젝트의 HWP와 HWPX 문서를 rhwp로 열어 쪽을 보여 주고, 본문 글을 고쳐 같은 형식으로 저장한다.",
  "mark": "hwp",
  "icon": "<path d=\"M3 2.5h6.5L13 6v7.5H3z\"/><path d=\"M9.5 2.5V6H13M5.5 8.5v4M8.5 8.5v4M5.5 10.5h3\"/>",
  "surface": {
    "module": "ui/hwp.js",
    "composition": {
      "kind": "dom"
    },
    "params": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "opens": {
      "extensions": [
        "hwp",
        "hwpx"
      ]
    },
    "save": "hwp.save"
  },
  "preview": {
    "ink": "--fg"
  },
  "dependencies": {
    "@soksak/sidecar-files": ">=0.0.5"
  },
  "exposes": {
    "status": [
      {
        "name": "hwp.document",
        "description": "The open document: its path relative to the project root, its format hwp or hwpx, the SHA-256 version of the last read or write, whether it holds unsaved edits as modified, the number of pages, the caret as section, paragraph and character offset of the body text and its rectangle in page coordinates, the text of an input method composition or an empty string, and whether the file on disk is the same or changed.",
        "schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "modified": {
              "type": "boolean"
            },
            "pages": {
              "type": "integer"
            },
            "caret": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "integer"
                },
                "paragraph": {
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                }
              }
            },
            "composing": {
              "type": "string"
            },
            "disk": {
              "type": "string",
              "enum": [
                "same",
                "changed"
              ]
            },
            "caretRect": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    ],
    "commands": [
      {
        "name": "hwp.save",
        "description": "Writes the document in its own format in place when the file on disk still has the version that the surface read; with overwrite, writes over the version that changed on disk. Content that the format would lose and other failures are shown as the tab's error.",
        "params": {
          "type": "object",
          "properties": {
            "overwrite": {
              "type": "boolean"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "hwp.reload",
        "description": "Reads the file again and discards unsaved edits.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "hwp.edit",
        "description": "Edits the body text at the caret: insert text, enter, backspace or delete, or moves the caret left, right, up or down.",
        "params": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "insert",
                "enter",
                "backspace",
                "delete",
                "left",
                "right",
                "up",
                "down"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "caret": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "integer"
                },
                "paragraph": {
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      {
        "name": "hwp.point",
        "description": "Places the caret at a point of a page in page coordinates.",
        "params": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "caret": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "integer"
                },
                "paragraph": {
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      {
        "name": "hwp.caret",
        "description": "Places the caret at a section, paragraph and character offset.",
        "params": {
          "type": "object",
          "properties": {
            "section": {
              "type": "integer"
            },
            "paragraph": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "caret": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "integer"
                },
                "paragraph": {
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      {
        "name": "hwp.compose",
        "description": "Shows the text of an input method composition at the caret, or removes it with an empty string.",
        "params": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "hwp.text",
        "description": "Returns the body text: paragraphs joined by a line break and sections by a blank line.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "string"
        }
      },
      {
        "name": "hwp.focus",
        "description": "Focuses the input field at the caret.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      }
    ],
    "dom": [
      {
        "name": "hwp.frame",
        "description": "The HWP surface."
      },
      {
        "name": "hwp.banner",
        "description": "The line that states that the file changed on disk."
      },
      {
        "name": "hwp.reload",
        "description": "The button that reads the file again."
      },
      {
        "name": "hwp.overwrite",
        "description": "The button that writes over the file that changed on disk."
      },
      {
        "name": "hwp.pages",
        "description": "The pages of the document."
      },
      {
        "name": "hwp.input",
        "description": "The input field at the caret that takes typed text and composition."
      }
    ]
  }
}
